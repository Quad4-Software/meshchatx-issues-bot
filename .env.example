# Bot identity and LXMF behavior
BOT_NAME=MeshChatX Issues
# Slash prefix, or leave empty for no prefix (first word is the command)
COMMAND_PREFIX=/
# COMMAND_PREFIX=
ANNOUNCE_SECONDS=600
ANNOUNCE_IMMEDIATELY=true
FIRST_MESSAGE_ENABLED=true
STORAGE_PATH=data
# RETICULUM_CONFIG_DIR=~/.reticulum
# TEST_MODE=false

# Comma-separated 32-char LXMF hashes (lowercase hex)
# Example: ADMIN_LXMF=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ADMIN_LXMF=
# Optional display names if announce has none: hash:Name,hash:Name
ADMIN_NAMES=
# Recall RNS identity from destination hash and verify signatures (recommended)
REQUIRE_IDENTITY_VERIFICATION=true
# Who receives new reports. Defaults to ADMIN_LXMF when unset.
NOTIFY_LXMF=

RATE_LIMIT=10
COOLDOWN=30
# LXMF stamp cost for inbound messages and outbound replies (1-254)
# Disable with 0, none, off, or false
STAMP_COST=8
# Pre-issue tickets and attach them on outbound LXMF to ADMIN_LXMF / NOTIFY_LXMF
GRANT_ADMIN_TICKETS=true
LIST_ISSUES_LIMIT=20
MAX_ISSUE_BODY=4000
FORWARD_ATTACHMENTS=true
MAX_ATTACHMENTS_PER_ISSUE=5
MAX_ATTACHMENT_BYTES=5242880

# Command names (without prefix)
CMD_REPORT=report
CMD_UPDATE=update
CMD_MYISSUES=myissues
CMD_ISSUE=issue
CMD_ISSUES=issues
CMD_CLOSE=close
CMD_BLOCK=block
CMD_UNBLOCK=unblock
CMD_BLOCKED=blocked
